# Deny by default: do not send local business records, secrets, databases or the
# upstream Postiz checkout to the Docker daemon, even in an unused build layer.
**
!package.json
!yarn.lock
!tsconfig.json
!tsconfig.postiz.json
!scripts/
!scripts/build-postiz-assets.mjs
!scripts/start-postiz-railway.mjs
!config/
!config/postiz/
!config/postiz/brand.example.json
!config/postiz/sources.example.json
!src/
!src/postiz/
!src/postiz/**/*.ts
!src/postiz/web/
!src/postiz/web/index.html
!src/postiz/web/app.js
!src/postiz/web/styles.css
!src/agents/
!src/agents/generate-post/
!src/agents/generate-post/nodes/
!src/agents/generate-post/nodes/prompt-core.ts
src/postiz/tests/
**/*.test.ts
**/*.node-test.ts
**/.env*
**/*.pem
**/*.key
