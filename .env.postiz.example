# Copy to .env.postiz. Never commit the resulting file.
# Generate each secret independently with: openssl rand -hex 32
# Passwords are used in connection URLs: use URL-safe hex, not arbitrary punctuation.
# Local testing. For an always-on server, use your stable HTTPS domain.
POSTIZ_PUBLIC_URL=http://localhost:4007
POSTIZ_HTTP_PORT=4007
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=
POSTIZ_REDIS_PASSWORD=
TEMPORAL_DB_PASSWORD=
POSTIZ_API_LIMIT=30

# X application credentials belong only to the official Postiz container.
# Connect the account in Postiz once; the content worker does not need X tokens.
POSTIZ_X_API_KEY=
POSTIZ_X_API_SECRET=

# Obtain these from your own Postiz instance after initial signup and X connection.
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID=
# Native CLI default; Compose overrides this with its internal Docker service URL.
POSTIZ_BASE_URL=http://127.0.0.1:4007/api/public/v1

# Model credentials belong only to the content worker.
# gpt-4.1-mini is a documented OpenAI model; replace it if your provider lacks it.
CONTENT_MODEL_PROVIDER=openai
CONTENT_MODEL=gpt-4.1-mini
CONTENT_MODEL_API_KEY=
# Optional OpenAI-compatible endpoint, including /v1 if required by your provider.
CONTENT_MODEL_BASE_URL=
FIRECRAWL_API_KEY=
GETXAPI_TOKEN=

# For Docker: copy public examples here, then add only verified brand facts locally.
# This directory is ignored by Git and excluded from the image build context.
CONTENT_CONFIG_DIR=./deploy/postiz/private/content
CONTENT_BRAND_FILE=./deploy/postiz/private/content/brand.json
# Optional, Docker path. Leave empty until a valid source configuration is present.
CONTENT_SOURCES_FILE=
CONTENT_DB_PATH=./deploy/postiz/private/content.sqlite
CONTENT_POLL_INTERVAL_MS=60000
# Paid source discovery is separate from local queue polling (default: daily).
CONTENT_DISCOVERY_INTERVAL_MS=86400000
CONTENT_MAX_JOBS_PER_TICK=3
# Ordinary jobs auto-submit as Postiz drafts. A job explicitly enqueued with
# --schedule retains that scheduled mode. There is no immediate "now" mode.
CONTENT_AUTO_SUBMIT=true
